; Check the Gregorian month/day year rule against the day-of-year rule d < 80.
(set-logic QF_LIA)
(declare-const month Int)
(declare-const day Int)
(declare-const leap Int)
(declare-const year Int)
(assert (or (= leap 0) (= leap 1)))
(assert (and (<= 1 month) (<= month 12)))
(define-fun month-length ((m Int)) Int
  (ite (= m 2) (+ 28 leap)
    (ite (or (= m 4) (= m 6) (= m 9) (= m 11)) 30 31)))
(assert (and (<= 1 day) (<= day (month-length month))))
(define-fun days-before-month ((m Int)) Int
  (+ (ite (> m 1) 31 0)
     (ite (> m 2) (+ 28 leap) 0)
     (ite (> m 3) 31 0)
     (ite (> m 4) 30 0)
     (ite (> m 5) 31 0)
     (ite (> m 6) 30 0)
     (ite (> m 7) 31 0)
     (ite (> m 8) 31 0)
     (ite (> m 9) 30 0)
     (ite (> m 10) 31 0)
     (ite (> m 11) 30 0)))
(define-fun d () Int (+ (days-before-month month) day))
(define-fun month-day-prior-year () Bool
  (or (< month 3) (and (= month 3) (< day (- 21 leap)))))
(define-fun doy-prior-year () Bool (< d 80))
(define-fun code-year () Int (- year (ite month-day-prior-year 2025 2024)))
(define-fun simplified-year () Int (- year 2024 (ite doy-prior-year 1 0)))
(assert (or (not (= month-day-prior-year doy-prior-year))
            (not (= code-year simplified-year))))
(check-sat)
